malta-road-recovery/data/raw/video/*.MP4
malta-road-recovery/data/raw/video/*.mp4
malta-road-recovery/data/raw/video/*.avi
malta-road-recovery/data/raw/video/*.mov

# =============================================================================
# Large synthetic data & ML outputs (regenerable)
# =============================================================================
malta-road-recovery/data/synthetic/scenarios/*/     # playback cache (regenerated by CLI)
malta-road-recovery/data/ml_training/              # training CSV (regenerated by CLI [4])
malta-road-recovery/models/recovery_rf_model.pkl   # trained model (regenerated by CLI [5])

